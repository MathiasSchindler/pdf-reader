{
  "name": "pdf-crumb",
  "version": "0.1.0",
  "description": "A tiny dependency-free browser PDF renderer experiment.",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "fuzz": "node fuzz/pdf-fuzz.js --mode=full",
    "fuzz:smoke": "node fuzz/pdf-fuzz.js --mode=smoke",
    "fuzz:epic": "node fuzz/pdf-fuzz.js --mode=epic",
    "fuzz:render": "node fuzz/render-fuzz.js",
    "fuzz:oracle": "node fuzz/oracle-fuzz.js",
    "fuzz:regression": "node fuzz/regression-run.js",
    "test:regression": "node scripts/renderer-tests.js",
    "test:security": "node scripts/security-tests.js",
    "bench:render": "node scripts/render-bench.js",
    "size": "node scripts/build.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.59.1",
    "terser": "^5.46.2"
  }
}
